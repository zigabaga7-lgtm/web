import javafx.application.Application;
import javafx.scene.Scene;
import javafx.scene.layout.Pane;
import javafx.scene.paint.Color;
import javafx.scene.shape.Circle;
import javafx.scene.text.Font;
import javafx.scene.text.Text;
import javafx.stage.Stage;

public class LogoApp extends Application {

    @Override
    public void start(Stage stage) {
        Pane root = new Pane();
        Scene scene = new Scene(root, 800, 600, Color.DARKSLATEBLUE);

        // Фон логотипа
        Circle circle = new Circle(300, 300, 250);
        circle.setFill(Color.WHITE);
        root.getChildren().add(circle);

        // Башня крана
        Text crane = new Text(250, 150, "⌚");
        crane.setFont(Font.font("Symbola", 100));
        crane.setFill(Color.BLACK);
        root.getChildren().add(crane);

        // Силуэты зданий
        Text buildings = new Text(200, 400, "🏙");
        buildings.setFont(Font.font("Symbola", 100));
        buildings.setFill(Color.BLACK);
        root.getChildren().add(buildings);

        // Текст "FORAM SANTE"
        Text text = new Text(250, 500, "FORAM SANTE");
        text.setFont(Font.font("Arial", 40));
        text.setFill(Color.BLACK);
        root.getChildren().add(text);

        stage.setTitle("Logo");
        stage.setScene(scene);
        stage.show();
    }

    public static void main(String[] args) {
        launch(args);
    }
}
